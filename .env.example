# Database
# POSTGRES_PASSWORD is interpolated raw into the backend's DATABASE_URL, so it
# must be letters and digits only — '@ : / ? # %' break the connection string.
# scripts/deploy.sh generates a safe one automatically.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ems_db

# Backend
# Generate with: openssl rand -hex 32
SECRET_KEY=your_super_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial admin account, created on first backend start (idempotent).
# Required in production — seeding refuses to run without a password.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@ems.local
SEED_ADMIN_PASSWORD=

# Frontend
# Not used by docker-compose.prod.yml: the production frontend calls the API
# same-origin at /api/v1 through nginx. This is for local, non-Docker runs.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Backend image
# The backend is NOT built on the server. Build and push it from your
# workstation with scripts/build_and_push.sh, then pin the tag it prints here.
# Prefer an explicit commit tag over :latest so you know exactly what is running.
BACKEND_IMAGE=docker.io/linmyatoo/ems-backend:latest

# Only needed on the server if the image repository is private. Create the token
# at hub.docker.com -> Account Settings -> Personal access tokens (read-only is
# enough for pulling). Leave blank for a public repository or if you have
# already run `docker login` on the server.
DOCKERHUB_USER=
DOCKERHUB_TOKEN=

# Production: HTTPS via nginx + Certbot (see nginx/init-letsencrypt.sh)
DOMAIN=yourdomain.com
CERTBOT_EMAIL=you@example.com
